{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci --no-audit --no-fund",
  "redirects": [
    { "source": "/agent-accueil-ia-medical", "destination": "/secretaire-medicale-augmentee", "permanent": true },
    { "source": "/assistant-telephone-ia-medecin", "destination": "/secretaire-medicale-augmentee-medecin", "permanent": true }
  ],
  "headers": [
    { "source": "/sitemap.xml", "headers": [{ "key": "Content-Type", "value": "application/xml" }] },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://*.google-analytics.com https://www.google-analytics.com https://connect.facebook.net https://js.stripe.com https://checkout.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://api.uwiapp.com https://*.up.railway.app https://*.railway.app https://www.google-analytics.com https://*.google-analytics.com https://stats.g.doubleclick.net https://www.facebook.com https://connect.facebook.net https://accounts.google.com https://api.stripe.com https://checkout.stripe.com; frame-src 'self' blob: https://js.stripe.com https://hooks.stripe.com https://checkout.stripe.com https://accounts.google.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com https://checkout.stripe.com; upgrade-insecure-requests"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://agent-production-c246.up.railway.app/api/$1" },
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/favicon.ico", "destination": "/favicon.ico" },
    { "source": "/favicon.png", "destination": "/favicon.png" },
    { "source": "/favicon.svg", "destination": "/favicon.svg" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/creer-assistante", "destination": "/creer-assistante/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/cgv", "destination": "/cgv/index.html" },
    { "source": "/cgu", "destination": "/cgu/index.html" },
    { "source": "/mentions-legales", "destination": "/mentions-legales/index.html" },
    { "source": "/politique-de-confidentialite", "destination": "/politique-de-confidentialite/index.html" },
    { "source": "/politique-cookies", "destination": "/politique-cookies/index.html" },
    { "source": "/pricing", "destination": "/pricing/index.html" },
    { "source": "/securite", "destination": "/securite/index.html" },
    { "source": "/secretaire-medicale-augmentee", "destination": "/secretaire-medicale-augmentee/index.html" },
    { "source": "/secretaire-medicale-augmentee-medecin", "destination": "/secretaire-medicale-augmentee-medecin/index.html" },
    { "source": "/assistant-telephone-ia-dentiste", "destination": "/assistant-telephone-ia-dentiste/index.html" },
    { "source": "/assistant-telephone-ia-kine", "destination": "/assistant-telephone-ia-kine/index.html" },
    { "source": "/assistant-telephone-ia-sage-femme", "destination": "/assistant-telephone-ia-sage-femme/index.html" },
    { "source": "/assistant-telephone-ia-dermatologue", "destination": "/assistant-telephone-ia-dermatologue/index.html" },
    { "source": "/assistant-telephone-ia-orthophoniste", "destination": "/assistant-telephone-ia-orthophoniste/index.html" },
    { "source": "/standard-telephonique-cabinet-medical", "destination": "/standard-telephonique-cabinet-medical/index.html" },
    { "source": "/p/(.*)", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
